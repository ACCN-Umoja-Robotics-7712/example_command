package frc.robot.subsystems;

import com.revrobotics.spark.SparkLowLevel.MotorType;
import com.revrobotics.spark.SparkMax;

import edu.wpi.first.wpilibj.DigitalInput;
import edu.wpi.first.wpilibj.smartdashboard.SmartDashboard;
import edu.wpi.first.wpilibj2.command.Command;
import edu.wpi.first.wpilibj2.command.SubsystemBase;

public class IntakeSubsystem extends SubsystemBase {
    private final SparkMax coralIntakeMotor;
    private final DigitalInput intakeSensor = new DigitalInput(1);

    private static final boolean SENSOR_ACTIVE_STATE = false; // Active-low

    public IntakeSubsystem() {
        coralIntakeMotor = new SparkMax(1, MotorType.kBrushless);

        coralIntakeMotor.restoreFactoryDefaults();
        coralIntakeMotor.setSmartCurrentLimit(30);
        coralIntakeMotor.burnFlash();
    }

    public void setIntakeSpeed(double speed) {
        coralIntakeMotor.set(speed);
    }

    public void stop() {
        coralIntakeMotor.stopMotor();
    }

    public boolean isGamePieceDetected() {
        return intakeSensor.get() == SENSOR_ACTIVE_STATE;
    }

    public Command runIntake(double speed) {
        return this.run(() -> setIntakeSpeed(speed)).withName("Run Intake");
    }

    public Command stopIntakeCmd() {
        return this.runOnce(this::stop).withName("Stop Intake");
    }

    public Command intakeUntilDetected(double speed) {
        return this.run(() -> setIntakeSpeed(speed))
            .until(this::isGamePieceDetected)
            .finallyDo(interrupted -> stop())
            .withName("Intake Until Detected");
    }

    @Override
    public void periodic() {
        SmartDashboard.putBoolean("Intake Sensor", isGamePieceDetected());
        SmartDashboard.putNumber("Intake Motor Output", coralIntakeMotor.getAppliedOutput());
    }
}
